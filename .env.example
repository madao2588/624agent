# Safe local defaults. Copy to .env only if your launcher loads dotenv files.
MEMORY_RUNTIME_MODE=local
MEMORY_DB_PATH=data/memory.db
MEMORY_NEIGHBOR_RADIUS=1
MEMORY_AUTH_SCHEME=none

# For a protected deployment, choose token, bearer, or x-api-key and inject a
# real secret outside source control.
# MEMORY_AUTH_SCHEME=bearer
# MEMORY_API_KEY=replace-at-runtime

# Optional durable OpenAI-compatible embeddings in local mode.
MEMORY_EMBEDDING_PROVIDER=none
# MEMORY_EMBEDDING_API_KEY=replace-at-runtime
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_BASE_URL=https://api.openai.com/v1
MEMORY_EMBEDDING_TIMEOUT_SECONDS=30
# MEMORY_EMBEDDING_DIMENSIONS=1536

# Frozen formal-evaluation mode. The checked-in profile fixes all other knobs.
# MEMORY_RUNTIME_MODE=evaluation
# MEMORY_EVALUATION_API_KEY=replace-at-runtime
MEMORY_EVALUATION_MODEL=gpt-4o-mini
MEMORY_EVALUATION_PROFILE=evaluation/evaluation-profile.json
